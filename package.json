{
  "name": "koeln-tycoon",
  "version": "1.0.0",
  "description": "Browserspiel: vom Kleindealer zum Boss auf der Karte von Köln",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-roads.mjs",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:phone": "node scripts/phone-shots.mjs",
    "screenshot:glas": "node scripts/glass-shots.mjs",
    "screenshot:minigames": "node scripts/minigame-shots.mjs",
    "audit:phone": "node scripts/phone-audit.mjs",
    "monkey:phone": "node scripts/phone-monkey.mjs",
    "template:smoke": "node scripts/template-smoke.mjs",
    "balance": "BALANCE=1 vitest run src/playtest --silent=false",
    "e2e": "node scripts/e2e.mjs",
    "saves:build": "node scripts/build-test-saves.mjs",
    "playthrough": "node scripts/playthrough.mjs",
    "perf:sim": "PERF=1 vitest run src/playtest/perf.bench.test.ts --silent=false",
    "perf:browser": "node scripts/perf-browser.mjs"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "maplibre-gl": "^6.11.2",
    "onnxruntime-web": "^1.30.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
