{
  "name": "koeln-tycoon",
  "version": "1.0.0",
  "description": "Browserspiel: vom Kleindealer zum Boss auf der Satellitenkarte von Köln",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "screenshot": "node scripts/screenshot.mjs",
    "template:smoke": "node scripts/template-smoke.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
